<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Единственное разрешение — микрофон для необязательного режима «Эхо».
        Оно запрашивается только после явного включения режима родителем и
        объяснения в диалоге; без него приложение полностью работает.
        INTERNET не запрашивается: записи некуда отправлять.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Android 11+ скрывает сторонние пакеты. Без этого запроса приложение
        не увидит системный синтезатор речи и названия животных не озвучатся
        (сам звук животного при этом работает).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhoSaysWhat">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
